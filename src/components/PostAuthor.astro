---
import type { AuthorData } from '@/utils/author'

interface Props {
  authors: AuthorData[]
}

const { authors } = Astro.props
---

{authors.length > 0 && (
  <div class="post-authors mb-6 flex flex-wrap gap-4">
    {
      authors.map((author) => {
        const { name, credentials, image, link, type, note } = author
        const isExternal = link?.startsWith('http')
        const content = (
          <>
            {image && (
              <img
                src={image}
                alt={name}
                class="h-12 w-12 rounded-full object-cover"
                loading="lazy"
              />
            )}
            <div class="flex flex-col">
              <span class="font-semibold c-primary">{name}</span>
              {credentials && <span class="text-xs c-secondary">{credentials}</span>}
              {type && <span class="text-xs uppercase tracking-wide c-tertiary">{type}</span>}
            </div>
          </>
        )
        return link ? (
          <a
            href={link}
            class="author-card flex items-center gap-3 rounded-lg border border-default p-3 text-sm"
            title={note || ''}
            target={isExternal ? '_blank' : undefined}
            rel={isExternal ? 'noopener noreferrer' : undefined}
          >
            {content}
          </a>
        ) : (
          <span
            class="author-card flex items-center gap-3 rounded-lg border border-default p-3 text-sm"
            title={note || ''}
          >
            {content}
          </span>
        )
      })
    }
  </div>
)}